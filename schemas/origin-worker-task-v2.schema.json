{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "originplot.origin_worker_task.v2",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "figure_spec",
    "output_dir",
    "operation_plan",
    "template_decision",
    "source_policy",
    "controller_privilege",
    "worker_privilege",
    "admin_policy"
  ],
  "properties": {
    "schema": {"const": "originplot.origin_worker_task.v2"},
    "profile": {"type": "object"},
    "figure_spec": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "operation_plan": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": {"const": "originplot.operation_plan.v1"}
      },
      "additionalProperties": true
    },
    "template_decision": {"type": "object"},
    "source_policy": {"type": "string", "minLength": 1},
    "controller_privilege": {"const": "standard_user_allowed"},
    "worker_privilege": {"const": "administrator_required_for_origin"},
    "admin_policy": {"const": "unchanged_from_v5"}
  },
  "additionalProperties": true
}
